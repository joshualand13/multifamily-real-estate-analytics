# Calculate median price per state
# Group by state to get median home price and the state's Cost of Living index
state_prices = (
    df.groupby("state")
    .agg(
        price=("price", "median"),
        col_index=("CostOfLivingIndexByState_2025", "first"),
    )
    .reset_index()
)

state_prices["state_code"] = state_prices["state"].map(us_state_to_abbrev)

# Create the text label for each state (e.g., "GA\n92.5")
state_prices["label"] = (
    state_prices["state_code"]
    + "<br>"
    + state_prices["col_index"].round(1).fillna("").astype(str)
)

# Create the interactive choropleth map
fig = px.choropleth(
    state_prices,
    locations="state_code",
    locationmode="USA-states",
    color="price",
    scope="usa",
    color_continuous_scale="Viridis",
    hover_data=["state", "price", "col_index"],
    title="Median Home Price & Cost of Living Index (2025) by State",
)

# Overlay text labels on top of each state
fig.add_trace(
    go.Scattergeo(
        locations=state_prices["state_code"],
        locationmode="USA-states",
        text=state_prices["label"],
        mode="text",
        textfont=dict(
            size=9,
            color="black",
            weight="bold",
        ),
        showlegend=False,
    )
)

fig.show()
