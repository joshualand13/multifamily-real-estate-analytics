#bringing in libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import plotly.express as px
import plotly.graph_objects as go


#importing data
df = pd.read_csv("realtor-data.csv")
col_df = pd.read_csv("cost-of-living-index-by-state-2026.csv")
#creating correlation matrix

df = pd.merge(
    df,
    col_df[["state", "CostOfLivingIndexByState_2025"]],
    on="state",
    how="left",
)

correlation = df.corr(numeric_only=True)

#visualize it

plt.figure(figsize=(8, 6))

sns.heatmap(
    correlation,
    annot=True,        # Show the correlation numbers inside the squares
    cmap='coolwarm',   # Red for positive, blue for negative
    vmin=-1, vmax=1,   # Lock the color scale from -1 to 1
    fmt='.2f'          # Round numbers to 2 decimal places
)

plt.title('Correlation Heatmap')
plt.show()


print(correlation)

